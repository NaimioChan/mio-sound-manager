{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reslip-p0-drag",
  "version": "0.1.0",
  "identifier": "com.naimio.reslip.p0drag",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ReSlip P0 — drag a file into a DAW",
        "width": 660,
        "height": 620,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
